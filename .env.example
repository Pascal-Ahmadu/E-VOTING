# --- Database (Vercel Postgres / Neon) ---
# Pooled connection string used by the app at runtime.
# In Vercel: Storage > Postgres > .env.local copy this from POSTGRES_PRISMA_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection used by `prisma migrate` only.
# In Vercel: from POSTGRES_URL_NON_POOLING.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Session encryption ---
# Used by iron-session to encrypt cookies. MUST be at least 32 chars.
# Generate one: `openssl rand -hex 32`
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# --- PII encryption ---
# AES-256-GCM key for field-level encryption of voter name/email/voterId.
# MUST be exactly 64 hex chars (32 bytes). Generate one: `openssl rand -hex 32`
# WARNING: rotating this key makes existing encrypted rows unreadable. Plan a
# re-encryption migration before changing it.
PII_ENCRYPTION_KEY="replace-with-64-hex-chars-from-openssl-rand-hex-32"

# --- Initial admin (seeded on first deploy) ---
# Used only by `prisma/seed.ts` if no admins exist yet.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Default Admin"
SEED_ADMIN_PASSCODE="VMK1234"

# --- Infobip WhatsApp messaging (optional) ---
# When set, voter credentials are sent via WhatsApp on registration.
# Obtain from https://portal.infobip.com → Channels → WhatsApp
INFOBIP_API_KEY=""
# Your unique Infobip base URL (found on the portal homepage)
INFOBIP_BASE_URL="xxxxxxxx.api.infobip.com"
# Approved WhatsApp sender number from Infobip
INFOBIP_SENDER="447860088970"
# Approved WhatsApp template with 4 body placeholders (name, voterId, password, url)
INFOBIP_TEMPLATE_NAME="voter_credentials"

# --- App public URL ---
# Used in the credential emails and WhatsApp messages sent to voters. There is
# no hardcoded fallback: if this is unset, the "Vote at" link is simply omitted.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
